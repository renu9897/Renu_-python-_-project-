import random
import string

# Kitna lamba password chahiye?
length = int(input("Kitne letters ka password chahiye? "))

# Saare letters + numbers + symbols
all_characters = string.ascii_letters + string.digits + string.punctuation

# Password banao
password = ""
for i in range(length):
    password += random.choice(all_characters)

print("Tumhara naya password hai: ", password)